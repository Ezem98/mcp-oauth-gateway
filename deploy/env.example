# ==============================================================================
# Configuración del MCP OAuth Gateway y Google MCP Server
# Archivo de variables de entorno para producción (/etc/mcp-gateway/env)
# Permisos recomendados en el servidor: chmod 600 /etc/mcp-gateway/env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Red y Servidor Gateway
# ------------------------------------------------------------------------------
# Puerto de escucha del gateway
PORT=4000

# Interfaz de escucha del gateway (127.0.0.1 asegura enlace exclusivo a loopback local)
LISTEN_HOST=127.0.0.1

# URL pública canónica del gateway.
# IMPORTANTE: Debe configurarse exactamente como http://localhost:4000 porque los
# identificadores de recursos ('aud' y metadata RFC 9728) de los tokens OAuth se
# construyen a partir de esta URL y OpenClaw debe configurarse con exactamente el
# mismo origen.
PUBLIC_URL=http://localhost:4000

# Nivel de detalle de logs (debug | info | warn | error)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Rutas de Almacenamiento y Archivos de Configuración
# ------------------------------------------------------------------------------
# Ruta de la base de datos SQLite (almacena clientes OAuth, códigos, tokens y vault)
DB_PATH=/opt/mcp-oauth-gateway/data/gateway.db

# Clave simétrica AES-256-GCM para cifrar tokens en credential_vault
# (Si el archivo no existe, el gateway lo generará automáticamente en el primer inicio)
VAULT_KEY_FILE=/opt/mcp-oauth-gateway/data/vault.key

# Token administrativo para acceder a la URL /connect/google
# (Si el archivo no existe, el gateway lo generará automáticamente en el primer inicio)
CONNECT_ADMIN_TOKEN_FILE=/opt/mcp-oauth-gateway/data/connect-admin.token

# Archivo JSON con los servidores MCP upstream que se registran al iniciar el gateway
SERVERS_FILE=/etc/mcp-gateway/servers.json

# Archivo JSON con la lista de políticas de herramientas permitidas/bloqueadas
POLICIES_FILE=/etc/mcp-gateway/policies.json

# ------------------------------------------------------------------------------
# 3. Identidad y Autorización
# ------------------------------------------------------------------------------
# Usuario por defecto que se aprueba en la pantalla de autorización OAuth (/authorize)
AUTH_DEFAULT_USER=ezequiel

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 (Consola de Google Cloud)
# ------------------------------------------------------------------------------
# Client ID de la credencial OAuth 2.0 tipo "Web application" creada en Google Cloud
GOOGLE_CLIENT_ID=CHANGE_ME

# Client Secret de la credencial OAuth 2.0 creada en Google Cloud
GOOGLE_CLIENT_SECRET=CHANGE_ME

# Callback URI de redirección autorizada en Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:4000/connect/google/callback

# ------------------------------------------------------------------------------
# 5. Servidor Google MCP Upstream (Gmail + Drive)
# ------------------------------------------------------------------------------
# Puerto en el que escucha el proceso google-mcp (en loopback 127.0.0.1)
GOOGLE_MCP_PORT=5002

# Secreto compartido entre el gateway y el servidor Google MCP (mínimo 32 caracteres).
# Generar un valor seguro con: openssl rand -hex 32
# IMPORTANTE: Debe coincidir exactamente con el valor configurado en
# "X-Google-MCP-Secret: <secreto>" dentro de /etc/mcp-gateway/servers.json
GOOGLE_MCP_SHARED_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# URL del gateway utilizada internamente por el proceso google-mcp para solicitar tokens vended.
# IMPORTANTE: GOOGLE_MCP_GATEWAY_URL usa 127.0.0.1 (el endpoint de vending no discrimina por host).
GOOGLE_MCP_GATEWAY_URL=http://127.0.0.1:4000

# ------------------------------------------------------------------------------
# 6. Servidores de Demostración (Irrelevantes en Producción)
# ------------------------------------------------------------------------------
# NOTA: Las variables de demostración local (DEMO_SERVER_ID, DEMO_SERVER_UPSTREAM_URL,
# DEMO_SERVER_UPSTREAM_AUTH_HEADER) son irrelevantes en producción porque la definición
# de los servidores upstream reales se realiza a través de SERVERS_FILE (/etc/mcp-gateway/servers.json).
