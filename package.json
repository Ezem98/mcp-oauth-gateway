{
  "name": "mcp-oauth-gateway",
  "version": "0.1.0",
  "description": "OAuth gateway for MCP servers — wrap any MCP server with OAuth 2.1 + PKCE + Dynamic Client Registration without modifying the server.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "connect-url": "tsx scripts/connect-url.ts",
    "e2e": "tsx scripts/e2e.ts",
    "browser-flow": "tsx scripts/browser-flow.ts",
    "mock-upstream": "tsx scripts/mock-upstream.ts",
    "google-mcp": "tsx upstreams/google/server.ts",
    "full-e2e": "tsx scripts/full-e2e.ts"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "nanoid": "^6.0.2",
    "zod": "^4.6.7",
    "dotenv": "^18.0.9",
    "jose": "^6.2.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
