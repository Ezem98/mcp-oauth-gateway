# Gateway server
PORT=4000
PUBLIC_URL=http://localhost:4000

# DB
DB_PATH=./data/gateway.db

# JWT signing (auto-generated on first run if empty)
JWT_PRIVATE_KEY=

# Logging
LOG_LEVEL=info

# Upstream MCP server (demo target)
# Configure one demo server inline; admin UI / config DB comes later.
DEMO_SERVER_ID=memory-demo
DEMO_SERVER_UPSTREAM_URL=http://localhost:5001/mcp
DEMO_SERVER_UPSTREAM_AUTH_HEADER=

# JSON file registering upstream MCP servers on boot (optional)
# Expected JSON shape:
# [
#   {
#     "server_id": "memory",
#     "display_name": "Memory MCP Server",
#     "upstream_url": "http://localhost:5001/mcp",
#     "upstream_auth_header": "Authorization: Bearer secret-token"
#   }
# ]
SERVERS_FILE=

# JSON file registering per-tool allow/deny policies on boot (optional)
# Expected JSON shape:
# {
#   "google": {
#     "gmail_search": "allow",
#     "gmail_read": "allow",
#     "gmail_create_draft": "allow",
#     "drive_search": "allow",
#     "drive_read": "allow"
#   }
# }
POLICIES_FILE=

# Authorization page
AUTH_DEFAULT_USER=demo-user@local

# Google OAuth 2.0 client ID (optional)
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 client secret (optional)
GOOGLE_CLIENT_SECRET=

# Google OAuth 2.0 redirect URI (optional)
GOOGLE_REDIRECT_URI=

# Vault encryption key file path (default: ./data/vault.key)
VAULT_KEY_FILE=./data/vault.key

# Connect admin token file path (default: ./data/connect-admin.token)
CONNECT_ADMIN_TOKEN_FILE=./data/connect-admin.token

# Google MCP Server (upstreams/google)
# Note: In the gateway's SERVERS_FILE (or DEMO_SERVER_UPSTREAM_AUTH_HEADER),
# upstream_auth_header must be configured as:
# "X-Google-MCP-Secret: <same secret as GOOGLE_MCP_SHARED_SECRET>"
GOOGLE_MCP_PORT=5002
# Required: Shared secret between gateway and Google MCP server (min 32 characters)
GOOGLE_MCP_SHARED_SECRET=
GOOGLE_MCP_GATEWAY_URL=http://localhost:4000
GOOGLE_GMAIL_API_BASE=https://gmail.googleapis.com
GOOGLE_DRIVE_API_BASE=https://www.googleapis.com
